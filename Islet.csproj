<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Islet</RootNamespace>
    <AssemblyName>Islet</AssemblyName>
    <ApplicationIcon>Assets\Islet.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Islet.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Notification icons for apps without a usable icon of their own (e.g. web Instagram).
         Copied next to Islet.exe; name each file after the app, e.g. instagram.png. -->
    <Content Include="Assets\AppIcons\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
