    <SolidColorBrush x:Key="Accent.Default"    Color="#FF4C9AFF"/>
    <SolidColorBrush x:Key="Warn.Dnd"          Color="#FFFFB020"/>
    <SolidColorBrush x:Key="Accent.Timer"      Color="#FFFF9F0A"/>

</ResourceDictionary>
