<Window x:Class="Islet.Shell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Islet 設定" Width="800" Height="580" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#FF1B1B1B" Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei"
        FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Left navigation item: icon + label, the current one gets a highlight and an accent bar. -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5"
                                        Background="{DynamicResource Accent.Default}" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Card}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1.5"
                                    Background="Transparent" BorderBrush="{DynamicResource Text.Secondary}"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                                     HorizontalAlignment="Left" Fill="{DynamicResource Text.Secondary}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent.Default}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent.Default}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: thin track, accent fill, round white thumb -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent.Default}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderBlank" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IsletSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Hover}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderBlank}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A settings row container -->
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,12,0,8"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Up/down arrows on the page list; dim when they can't move further. -->
        <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.25"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bordered button for the main actions in the window -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,5" BorderThickness="1"
                                Background="{DynamicResource Surface.Card}" BorderBrush="{DynamicResource Surface.Hover}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (background type, fit). Reuses the islet's TabButton look. -->
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource TabButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation ================= -->
        <Border Background="#FF161616">
            <StackPanel Margin="10,18,10,10">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,20">
                    <Border Width="34" Height="16" CornerRadius="8" Background="Black"
                            BorderBrush="{DynamicResource Surface.Hover}" BorderThickness="1" VerticalAlignment="Center"/>
                    <TextBlock Text="Islet 設定" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <RadioButton GroupName="Nav" Tag="general" Style="{StaticResource NavButton}" IsChecked="True"
                             Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Width="38" TextAlignment="Center"/>
                        <TextBlock Text="一般" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav" Tag="home" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" Width="38" TextAlignment="Center"/>
                        <TextBlock Text="首頁背景" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav" Tag="pages" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" Width="38" TextAlignment="Center"/>
                        <TextBlock Text="分頁" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav" Tag="about" Style="{StaticResource NavButton}" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Width="38" TextAlignment="Center"/>
                        <TextBlock Text="關於" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ================= Sections ================= -->
        <Grid Grid.Column="1">

            <!-- ===== General ===== -->
            <ScrollViewer x:Name="SectionGeneral" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="一般" Style="{StaticResource SectionTitle}"/>

                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"/>
                            <StackPanel>
                                <TextBlock Text="開機時自動啟動" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="登入 Windows 後自動開啟 Islet" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="展開與收合" Style="{StaticResource GroupLabel}"/>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HoverDelayText}"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="滑鼠停留多久後展開" Style="{StaticResource RowTitle}"/>
                            </DockPanel>
                            <TextBlock Text="時間越長，越不容易在點瀏覽器分頁時誤開" Style="{StaticResource Caption}"/>
                            <Slider Style="{StaticResource IsletSlider}" Margin="0,8,0,0"
                                    Minimum="0" Maximum="1500" Value="{Binding HoverDelayMs, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CollapseDelayText}"
                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBlock Text="滑鼠離開後多久收合" Style="{StaticResource RowTitle}"/>
                            </DockPanel>
                            <TextBlock Text="時間越長，滑鼠不小心滑出去也不會馬上收起來" Style="{StaticResource Caption}"/>
                            <Slider Style="{StaticResource IsletSlider}" Margin="0,8,0,0"
                                    Minimum="0" Maximum="1500" Value="{Binding CollapseDelayMs, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      IsChecked="{Binding ResetPageOnExpand, Mode=TwoWay}"/>
                            <StackPanel>
                                <TextBlock Text="每次展開都回到第一頁" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="關閉時，會停在上次看的分頁" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="勿擾、模式與固定展開，可以在島上按右鍵快速切換。" Style="{StaticResource Caption}"
                               Margin="2,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Home background ===== -->
            <ScrollViewer x:Name="SectionHome" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="首頁背景" Style="{StaticResource SectionTitle}"/>

                    <!-- Live preview: the expanded islet at 90 %, using the same brushes as the real one. -->
                    <Border Style="{StaticResource SettingCard}" Padding="16">
                        <StackPanel>
                            <Viewbox Width="378" HorizontalAlignment="Center" Stretch="Uniform">
                                <Grid Width="420" Height="200">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,420,200" RadiusX="28" RadiusY="28"/>
                                    </Grid.Clip>

                                    <Border Background="{DynamicResource Islet.Background}"/>

                                    <Grid Visibility="{Binding Main.HasHomeBackdrop, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{Binding Main.HomeBackdropBrush}"
                                                Margin="{Binding Main.HomeBlurMargin}">
                                            <Border.Effect>
                                                <BlurEffect Radius="{Binding Main.HomeBlurRadius}" KernelType="Gaussian"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border Background="Black" Opacity="{Binding Main.HomeDimOpacity}"/>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#73000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="0.28"/>
                                                    <GradientStop Color="#00000000" Offset="0.78"/>
                                                    <GradientStop Color="#73000000" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <Border Margin="18,38,18,24" CornerRadius="14" Background="{DynamicResource Surface.Card}"
                                            Visibility="{Binding Main.HomeShowHint, Converter={StaticResource BoolToVis}}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Main.HomeHintGlyph}" Style="{StaticResource Glyph}"
                                                       FontSize="22" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource Text.Secondary}"/>
                                            <TextBlock Text="{Binding Main.HomeHintText}" Margin="0,6,0,0"
                                                       HorizontalAlignment="Center" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Header chips, as on the islet -->
                                    <DockPanel Margin="18,10,18,0" Height="22" VerticalAlignment="Top">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Border CornerRadius="10" Padding="8,2" Background="{DynamicResource Surface.Card}">
                                                <TextBlock Text="{Binding Main.Mode, StringFormat='模式 · {0}'}"
                                                           Style="{StaticResource Caption}"/>
                                            </Border>
                                        </StackPanel>
                                        <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                Background="{DynamicResource Surface.Card}">
                                            <TextBlock Text="{Binding Main.ClockText}" Style="{StaticResource Caption}"/>
                                        </Border>
                                    </DockPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom" Margin="0,0,0,10">
                                        <Border Width="18" Height="6" CornerRadius="3" Margin="3,0" Background="White"/>
                                        <Border Width="6" Height="6" CornerRadius="3" Margin="3,0" Background="White" Opacity="0.3"/>
                                        <Border Width="6" Height="6" CornerRadius="3" Margin="3,0" Background="White" Opacity="0.3"/>
                                        <Border Width="6" Height="6" CornerRadius="3" Margin="3,0" Background="White" Opacity="0.3"/>
                                    </StackPanel>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="預覽 · 變更會立即套用到島上" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="圖片" GroupName="BgKind" Style="{StaticResource Segment}"
                                             IsChecked="{Binding IsBgImage, Mode=TwoWay}"/>
                                <RadioButton Content="純色" GroupName="BgKind" Style="{StaticResource Segment}"
                                             IsChecked="{Binding IsBgColor, Mode=TwoWay}"/>
                                <RadioButton Content="音樂封面" GroupName="BgKind" Style="{StaticResource Segment}"
                                             IsChecked="{Binding IsBgCover, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="背景類型" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="音樂封面：播放時顯示目前歌曲的封面" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Picture options -->
                    <StackPanel Visibility="{Binding IsBgImage, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="選擇圖片…" Style="{StaticResource ActionButton}" Click="PickPicture_Click"/>
                                    <Button Content="移除" Style="{StaticResource ActionButton}" Click="RemovePicture_Click"
                                            IsEnabled="{Binding Main.HasHomeWallpaper}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="圖片" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="會複製一份保存，原檔移動或刪除也沒關係" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource SettingCard}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="填滿" GroupName="Fit" Style="{StaticResource Segment}"
                                                 IsChecked="{Binding IsFitFill, Mode=TwoWay}"/>
                                    <RadioButton Content="完整顯示" GroupName="Fit" Style="{StaticResource Segment}"
                                                 IsChecked="{Binding IsFitFit, Mode=TwoWay}"/>
                                    <RadioButton Content="延展" GroupName="Fit" Style="{StaticResource Segment}"
                                                 IsChecked="{Binding IsFitStretch, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="填滿方式" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="填滿會裁掉超出的部分；完整顯示會留黑邊" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Solid colour options -->
                    <Border Style="{StaticResource SettingCard}"
                            Visibility="{Binding IsBgColor, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="顏色" Style="{StaticResource RowTitle}"/>
                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Swatch_Click" Cursor="Hand" Margin="0,0,8,0" ToolTip="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Width="32" Height="32" Background="Transparent">
                                                        <Ellipse Fill="{Binding Brush}" Margin="4"
                                                                 Stroke="{DynamicResource Surface.Hover}" StrokeThickness="1"/>
                                                        <Ellipse Stroke="White" StrokeThickness="2"
                                                                 Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="自訂色碼" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <TextBox Width="120" Margin="10,0,0,0" Padding="6,3"
                                         Text="{Binding ColorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{DynamicResource Surface.Card}" Foreground="{DynamicResource Text.Primary}"
                                         CaretBrush="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Surface.Hover}"/>
                                <TextBlock Text="格式：#RRGGBB" Style="{StaticResource Caption}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Accent.Timer}"
                                           Visibility="{Binding ColorTextInvalid, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="效果" Style="{StaticResource GroupLabel}"/>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DimText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="暗化" Style="{StaticResource RowTitle}"/>
                            </DockPanel>
                            <TextBlock Text="圖片太亮、看不清上方的時間時調高" Style="{StaticResource Caption}"/>
                            <Slider Style="{StaticResource IsletSlider}" Margin="0,8,0,0"
                                    Minimum="0" Maximum="80" Value="{Binding Dim, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BlurText}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="模糊" Style="{StaticResource RowTitle}"/>
                            </DockPanel>
                            <TextBlock Text="讓背景變成柔和的色塊" Style="{StaticResource Caption}"/>
                            <Slider Style="{StaticResource IsletSlider}" Margin="0,8,0,0"
                                    Minimum="0" Maximum="30" Value="{Binding Blur, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Pages ===== -->
            <ScrollViewer x:Name="SectionPages" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,32">
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="還原預設" Style="{StaticResource ActionButton}"
                                VerticalAlignment="Center" Click="ResetPages_Click"/>
                        <TextBlock Text="分頁" Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,12" TextWrapping="Wrap"
                               Text="開關決定島上要不要顯示這一頁，箭頭調整順序。滾輪與下方圓點會依照這個順序切換，最上面的是第一頁。"/>

                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SettingCard}" Margin="0,0,0,6" Padding="14,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="&#xE70E;" ToolTip="往前移"
                                                Style="{StaticResource RowIconButton}"
                                                IsEnabled="{Binding CanMoveUp}" Click="MoveUp_Click"/>
                                        <Button Grid.Column="3" Content="&#xE70D;" ToolTip="往後移"
                                                Style="{StaticResource RowIconButton}"
                                                IsEnabled="{Binding CanMoveDown}" Click="MoveDown_Click"/>
                                        <CheckBox Grid.Column="4" Margin="14,0,0,0" Style="{StaticResource Switch}"
                                                  ToolTip="顯示這一頁"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="至少要保留一頁。" Style="{StaticResource Caption}" Margin="2,6,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== About ===== -->
            <ScrollViewer x:Name="SectionAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,32">
                    <TextBlock Text="關於" Style="{StaticResource SectionTitle}"/>

                    <Border Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="Islet" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                            <TextBlock Text="Windows 上的靈動島 · MIT 授權 · © shubingx" Style="{StaticResource Caption}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="開啟資料夾" Style="{StaticResource ActionButton}"
                                    VerticalAlignment="Center" Click="OpenDataFolder_Click"/>
                            <StackPanel>
                                <TextBlock Text="設定與資料" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="DataFolderText" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource SettingCard}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="開啟記錄" Style="{StaticResource ActionButton}"
                                    VerticalAlignment="Center" Click="OpenLog_Click"/>
                            <StackPanel>
                                <TextBlock Text="錯誤記錄" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="回報問題時可以附上這個檔案" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
