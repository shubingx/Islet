    <SolidColorBrush x:Key="Text.Primary"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Secondary"    Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Card"      Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Hover"     Color="#26FFFFFF"/>
