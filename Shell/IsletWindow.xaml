<Window x:Class="Islet.Shell.IsletWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Islet" Width="174" Height="66"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Microsoft JhengHei"
        FontSize="13" Foreground="{DynamicResource Text.Primary}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- Root is scaled by IsletWindow.UiScale (LayoutTransform set in code). -->
    <Grid x:Name="Root">
        <!-- The islet. Width/Height/CornerRadius are driven by the spring animator.
             Hover is detected by polling the cursor (see HoverPoll), because the collapsed
             islet is click-through and receives no mouse events. -->
        <Grid x:Name="IsletHost" Width="126" Height="34"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
              PreviewMouseWheel="Islet_MouseWheel">

            <Grid.ContextMenu>
                <ContextMenu Opened="Menu_Opened" Closed="Menu_Closed" MenuItem.Click="Menu_Click">
                    <MenuItem Header="勿擾" Tag="dnd" IsCheckable="True"/>
                    <MenuItem Header="固定展開" Tag="pin" IsCheckable="True"/>
                    <MenuItem Header="模式">
                        <MenuItem Header="一般" Tag="mode:一般" IsCheckable="True"/>
                        <MenuItem Header="專注" Tag="mode:專注" IsCheckable="True"/>
                        <MenuItem Header="自訂" Tag="mode:自訂" IsCheckable="True"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="結束" Tag="exit"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- Background shape + shadow -->
            <Border x:Name="IsletBg" Background="{DynamicResource Islet.Background}" CornerRadius="17">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                </Border.Effect>
            </Border>

            <!-- Clipped content layers -->
            <Grid x:Name="ContentHost" ClipToBounds="True">

                <!-- ============ Idle (collapsed) ============ -->
                <Grid x:Name="IdleLayer" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="26"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="26"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="5"
                                Background="{Binding CoverBrush}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                        <Ellipse Width="7" Height="7" Margin="6,0,0,0" Fill="{DynamicResource Warn.Dnd}"
                                 Visibility="{Binding IsDnd, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <Rectangle x:Name="EqA" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0"
                                   Fill="{Binding AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="EqB" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="0,0,2,0"
                                   Fill="{Binding AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle x:Name="EqC" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{Binding AccentBrush}" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <!-- ============ Peek (one-line summary) ============ -->
                <Grid x:Name="PeekLayer" Width="300" Height="46" Opacity="0" IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="12,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="13" VerticalAlignment="Center"
                                Background="{Binding PeekBadgeBrush}">
                            <TextBlock Text="{Binding PeekBadge}" FontWeight="Bold" FontSize="13"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding PeekText}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ============ Expanded ============ -->
                <Grid x:Name="ExpandedLayer" Width="420" Height="200" Opacity="0" IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Margin="18,10,18,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>

                        <!-- Header (every page): clock chip on the left, mode chip + DND on the right -->
                        <DockPanel Grid.Row="0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="10" Padding="8,2" Margin="0,0,6,0" Cursor="Hand"
                                        Background="{DynamicResource Surface.Card}"
                                        MouseLeftButtonUp="Mode_Click">
                                    <TextBlock Text="{Binding Mode, StringFormat='模式 · {0}'}" Style="{StaticResource Caption}"/>
                                </Border>
                                <ToggleButton Content="勿擾" Style="{StaticResource DndToggle}"
                                              IsChecked="{Binding IsDnd, Mode=TwoWay}"/>
                            </StackPanel>

                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Card}">
                                <TextBlock Text="{Binding ClockText}" Style="{StaticResource Caption}"/>
                            </Border>
                        </DockPanel>

                        <!-- Pages (one visible at a time; mouse wheel / dots switch) -->
                        <Grid x:Name="PagesHost" Grid.Row="2" ClipToBounds="True">

                        <!-- Page: Home (date/time now lives in the header chip) -->
                        <Grid x:Name="PageHome" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="下一項待辦" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding NextTodoTitle}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding NextTodoDue}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="腳本卡片 · hello-card" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="今天也要加油！" FontWeight="SemiBold"/>
                                    <TextBlock Text="（示範用，之後由腳本提供）" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Page: Music -->
                        <Grid x:Name="PageMusic" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="100" Height="100" CornerRadius="16"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{Binding CoverBrush}"
                                    Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="♪" FontSize="44" Foreground="#80FFFFFF"
                                           Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVis}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Column="1" VerticalAlignment="Center"
                                  Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding TrackSource}" Style="{StaticResource Caption}"/>
                                <TextBlock Grid.Row="1" Text="{Binding TrackTitle}" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="2" Text="{Binding TrackArtist}" Style="{StaticResource Body}"
                                           Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>

                                <Grid Grid.Row="3" Height="16" Margin="0,8,0,0" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="Progress_MouseDown">
                                    <ProgressBar Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                 Value="{Binding ProgressFraction, Mode=OneWay}"
                                                 Foreground="{Binding AccentBrush}"
                                                 Style="{StaticResource MusicProgress}"
                                                 IsHitTestVisible="False"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="&#xE892;" Style="{StaticResource IconButton}" Click="Prev_Click"/>
                                    <Button Content="{Binding PlayGlyph}" Style="{StaticResource IconButton}"
                                            FontSize="20" Click="Play_Click"/>
                                    <Button Content="&#xE893;" Style="{StaticResource IconButton}" Click="Next_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.ColumnSpan="2" Text="目前沒有播放音樂" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoMedia, Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <!-- Page: Notifications -->
                        <Grid x:Name="PageNotif" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Content="清除全部" Style="{StaticResource PillButton}"
                                        Click="ClearAll_Click"/>
                                <TextBlock Text="{Binding NotifSummary}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                          Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Notifications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10,8"
                                                    Cursor="Hand" MouseLeftButtonUp="Notif_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="28" Height="28" VerticalAlignment="Center"
                                                          ToolTip="{Binding AppName}">
                                                        <Border CornerRadius="14" Background="{Binding BadgeBrush}"
                                                                Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding Badge}" FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Image Source="{Binding Icon}" Width="26" Height="26"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                                            <TextBlock Text="{Binding Context}" Style="{StaticResource Caption}"
                                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="110"
                                                                       Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}"/>
                                                            <Ellipse Width="6" Height="6" Margin="6,0,0,0"
                                                                     Fill="{DynamicResource Accent.Default}"
                                                                     Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Body}" Style="{StaticResource Caption}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                                   HorizontalAlignment="Right"/>
                                                        <Button Content="✕" FontSize="10" Style="{StaticResource PillButton}"
                                                                HorizontalAlignment="Right" Click="Notif_Dismiss"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoNotifications, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding NotifEmptyText}" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="開啟通知存取設定" Style="{StaticResource PillButton}" Margin="0,8,0,0"
                                        HorizontalAlignment="Center" Click="NotifSettings_Click"
                                        Visibility="{Binding NotifNeedsAccess, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Page: Todo -->
                        <Grid x:Name="PageTodo" Visibility="Collapsed">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource Card}" CornerRadius="16" Padding="12,0">
                                <Grid>
                                    <TextBlock x:Name="TodoHint" Text="新增待辦，按 Enter" Style="{StaticResource Caption}"
                                               FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <TextBox x:Name="TodoInput" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource Text.Primary}"
                                             CaretBrush="{DynamicResource Text.Primary}"
                                             VerticalContentAlignment="Center"
                                             TextChanged="Todo_TextChanged" KeyDown="Todo_KeyDown"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                                <ItemsControl ItemsSource="{Binding Todos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Due}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}">
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        </Grid>

                        <!-- Page dots -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <RadioButton x:Name="TabHome" Tag="0" GroupName="Tabs" ToolTip="首頁"
                                         Style="{StaticResource PageDot}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabMusic" Tag="1" GroupName="Tabs" ToolTip="音樂"
                                         Style="{StaticResource PageDot}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabNotif" Tag="2" GroupName="Tabs" ToolTip="{Binding NotifTabText}"
                                         Style="{StaticResource PageDot}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabTodo" Tag="3" GroupName="Tabs" ToolTip="待辦"
                                         Style="{StaticResource PageDot}" Checked="Tab_Checked"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
