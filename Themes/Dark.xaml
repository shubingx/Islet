<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme tokens: swap this file (or add Light.xaml) to re-skin the islet. -->
    <SolidColorBrush x:Key="Islet.Background" Color="#FF050505"/>
    <SolidColorBrush x:Key="Text.Primary"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Text.Secondary"    Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Card"      Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Hover"     Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Surface.Selected"  Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Accent.Default"    Color="#FF4C9AFF"/>
    <SolidColorBrush x:Key="Warn.Dnd"          Color="#FFFFB020"/>
    <SolidColorBrush x:Key="Accent.Timer"      Color="#FFFF9F0A"/>

    <!-- Performance rings: white below 60 %, orange from 60 %, red from 85 %. -->
    <Color x:Key="Perf.Warn">#FFFF9F0A</Color>
    <Color x:Key="Perf.Critical">#FFFF453A</Color>
    <SolidColorBrush x:Key="Perf.WarnBrush" Color="#FFFF9F0A"/>

</ResourceDictionary>
